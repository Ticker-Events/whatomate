    {
      "name": "2. Orders (flow ops)",
      "item": [
        {
          "name": "Checkout (create order)",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              },
              {
                "key": "Accept",
                "value": "application/json, text/event-stream"
              },
              {
                "key": "X-MCP-API-Key",
                "value": "{{mcp_api_key}}"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"jsonrpc\": \"2.0\",\n  \"id\": 1,\n  \"method\": \"tools/call\",\n  \"params\": {\n    \"name\": \"create_order\",\n    \"arguments\": {\n      \"order\": {\n        \"store\": {{store_id}},\n        \"items\": [\n          {\n            \"product_option\": {{option_id}},\n            \"quantity\": 1\n          }\n        ],\n        \"email\": \"{{email}}\",\n        \"phone_number\": \"{{phone_number}}\",\n        \"delivery_mode\": \"PICKUP_FROM_STORE\",\n        \"notes\": \"Postman test order\",\n        \"slot_token\": \"{{slot_token}}\",\n        \"new_address\": {\n          \"name\": \"Preview Buyer\",\n          \"address_line_1\": \"123 Test Street\",\n          \"city\": \"Bengaluru\",\n          \"state\": \"KA\",\n          \"country\": \"IN\",\n          \"pincode\": \"560001\",\n          \"phone\": \"{{phone_number}}\"\n        }\n      }\n    }\n  }\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            },
            "url": "{{mcp_base_url}}/mcp",
            "description": "Whatomate flow operation `create_order` \u2192 MCP tool `create_order`.\n\nGuest checkout used by the flow node. Nested `order` payload.\n`delivery_mode`: PICKUP_FROM_STORE | DELIVERY_TO_LOCATION.\nFor delivery, include `new_address`. Optional `slot_token` / `notes`."
          },
          "response": []
        },
