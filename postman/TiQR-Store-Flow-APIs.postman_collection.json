      "name": "0. Session",
      "item": [
        {
          "name": "initialize",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              },
              {
                "key": "Accept",
                "value": "application/json, text/event-stream"
              },
              {
                "key": "X-MCP-API-Key",
                "value": "{{mcp_api_key}}"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"jsonrpc\": \"2.0\",\n  \"id\": 0,\n  \"method\": \"initialize\",\n  \"params\": {\n    \"protocolVersion\": \"2024-11-05\",\n    \"capabilities\": {},\n    \"clientInfo\": {\n      \"name\": \"postman-tiqr-store\",\n      \"version\": \"1.0.0\"\n    }\n  }\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            },
            "url": "{{mcp_base_url}}/mcp",
            "description": "Optional MCP handshake. With FastMCP `stateless_http=True` (ticker-events-backend default), individual `tools/call` requests usually work without persisting a session."
          },
          "response": []
        },
