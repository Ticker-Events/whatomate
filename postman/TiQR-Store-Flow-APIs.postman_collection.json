            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"jsonrpc\": \"2.0\",\n  \"id\": 1,\n  \"method\": \"tools/call\",\n  \"params\": {\n    \"name\": \"list_categories\",\n    \"arguments\": {\n      \"store_id\": {{store_id}},\n      \"limit\": 20,\n      \"offset\": 0,\n      \"tags\": [],\n      \"tags_op\": \"or\"\n    }\n  }\n}",
