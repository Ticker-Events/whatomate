            "url": "https://playgenicapi.demospro2023.in.net/api/wa/worker/customers/lookup",
            "body": "{\"whatsapp_number\":\"{{customer_phone}}\"}",
            "method": "POST",
            "headers": {
              "Content-Type": "application/json",
              "Authorization": "Bearer {{token}}"
            },
            "response_mapping": {
              "customer_id": "id",
              "customer_name": "full_name",
              "customer_phone": "whatsapp_number",
              "customer_exists": "exists",
              "customer_language": "language",
