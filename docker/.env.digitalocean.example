# DigitalOcean deployment environment
# Copy to docker/.env and fill in CHANGE_ME values before: docker compose up -d
#
# WHATOMATE_* vars override config.toml (see internal/config/config.go).
# ICE servers ([[calling.ice_servers]]) must stay in config.toml — not supported via env.

# -----------------------------------------------------------------------------
# Docker Compose (PostgreSQL container)
# -----------------------------------------------------------------------------
TZ=UTC

POSTGRES_USER=whatomate
POSTGRES_PASSWORD=CHANGE_ME_STRONG_DB_PASSWORD
POSTGRES_DB=whatomate

# -----------------------------------------------------------------------------
# App
# -----------------------------------------------------------------------------
WHATOMATE_APP_NAME=TiQR WhatsApp
WHATOMATE_APP_ENVIRONMENT=production
WHATOMATE_APP_DEBUG=false
WHATOMATE_APP_ENCRYPTION_KEY=CHANGE_ME_32_PLUS_CHAR_AES_KEY

# -----------------------------------------------------------------------------
# Server (behind DO Load Balancer or nginx on the droplet)
# -----------------------------------------------------------------------------
WHATOMATE_SERVER_HOST=0.0.0.0
WHATOMATE_SERVER_PORT=8080
WHATOMATE_SERVER_READ_TIMEOUT=30
WHATOMATE_SERVER_WRITE_TIMEOUT=30
WHATOMATE_SERVER_BASE_PATH=
WHATOMATE_SERVER_ALLOWED_ORIGINS=https://your-domain.com

# -----------------------------------------------------------------------------
# Database
# Use host=db when running the bundled Postgres container.
# For DO Managed PostgreSQL, set host to the cluster hostname and ssl_mode=require.
# -----------------------------------------------------------------------------
WHATOMATE_DATABASE_HOST=db
WHATOMATE_DATABASE_PORT=5432
WHATOMATE_DATABASE_USER=whatomate
WHATOMATE_DATABASE_PASSWORD=CHANGE_ME_STRONG_DB_PASSWORD
WHATOMATE_DATABASE_NAME=whatomate
WHATOMATE_DATABASE_SSL_MODE=disable
WHATOMATE_DATABASE_MAX_OPEN_CONNS=25
WHATOMATE_DATABASE_MAX_IDLE_CONNS=5
WHATOMATE_DATABASE_CONN_MAX_LIFETIME=300

# Managed DB example (uncomment and remove bundled db service from compose):
# WHATOMATE_DATABASE_HOST=your-cluster.db.ondigitalocean.com
# WHATOMATE_DATABASE_PORT=25060
# WHATOMATE_DATABASE_SSL_MODE=require

# -----------------------------------------------------------------------------
# Redis
# Use host=redis for the bundled container.
# For DO Managed Redis/Valkey, set host, password, and tls=true.
# -----------------------------------------------------------------------------
WHATOMATE_REDIS_HOST=redis
WHATOMATE_REDIS_PORT=6379
WHATOMATE_REDIS_USERNAME=
WHATOMATE_REDIS_PASSWORD=
WHATOMATE_REDIS_DB=0
WHATOMATE_REDIS_TLS=false

# Managed Redis example:
# WHATOMATE_REDIS_HOST=your-redis.db.ondigitalocean.com
# WHATOMATE_REDIS_PORT=25061
# WHATOMATE_REDIS_PASSWORD=CHANGE_ME
# WHATOMATE_REDIS_TLS=true

# -----------------------------------------------------------------------------
# JWT
# -----------------------------------------------------------------------------
WHATOMATE_JWT_SECRET=CHANGE_ME_AT_LEAST_32_CHAR_JWT_SECRET
WHATOMATE_JWT_ACCESS_EXPIRY_MINS=15
WHATOMATE_JWT_REFRESH_EXPIRY_DAYS=1

# -----------------------------------------------------------------------------
# Storage
# local works on a droplet with a mounted volume for ./uploads.
# For call recordings (recording_enabled=true), S3 or DO Spaces is recommended.
# Note: DO Spaces needs a custom endpoint — see code-changes note in docs.
# -----------------------------------------------------------------------------
WHATOMATE_STORAGE_TYPE=local
WHATOMATE_STORAGE_LOCAL_PATH=./uploads
WHATOMATE_STORAGE_S3_BUCKET=
WHATOMATE_STORAGE_S3_REGION=
WHATOMATE_STORAGE_S3_KEY=
WHATOMATE_STORAGE_S3_SECRET=

# -----------------------------------------------------------------------------
# Cookies
# -----------------------------------------------------------------------------
WHATOMATE_COOKIE_DOMAIN=
WHATOMATE_COOKIE_SECURE=true

# -----------------------------------------------------------------------------
# Rate limiting (enable in production; trust_proxy when behind LB/nginx)
# -----------------------------------------------------------------------------
WHATOMATE_RATE_LIMIT_ENABLED=true
WHATOMATE_RATE_LIMIT_LOGIN_MAX_ATTEMPTS=10
WHATOMATE_RATE_LIMIT_REGISTER_MAX_ATTEMPTS=10
WHATOMATE_RATE_LIMIT_REFRESH_MAX_ATTEMPTS=30
WHATOMATE_RATE_LIMIT_SSO_MAX_ATTEMPTS=10
WHATOMATE_RATE_LIMIT_WINDOW_SECONDS=60
WHATOMATE_RATE_LIMIT_TRUST_PROXY=true
WHATOMATE_RATE_LIMIT_API_MAX_REQUESTS=200
WHATOMATE_RATE_LIMIT_API_WINDOW_SECONDS=60

# -----------------------------------------------------------------------------
# Calling / WebRTC
# Set public_ip to your droplet's public IPv4 (required for WhatsApp voice).
# Open UDP ports 10000-10100 in the droplet firewall and docker-compose.
# Configure [[calling.ice_servers]] in config.toml (STUN/TURN).
# -----------------------------------------------------------------------------
WHATOMATE_CALLING_MAX_CALL_DURATION=300
WHATOMATE_CALLING_AUDIO_DIR=./audio
WHATOMATE_CALLING_TRANSFER_TIMEOUT_SECS=120
WHATOMATE_CALLING_RECORDING_ENABLED=true
WHATOMATE_CALLING_UDP_PORT_MIN=10000
WHATOMATE_CALLING_UDP_PORT_MAX=10100
WHATOMATE_CALLING_PUBLIC_IP=CHANGE_ME_DROPLET_PUBLIC_IP
# WHATOMATE_CALLING_RELAY_ONLY=true

# -----------------------------------------------------------------------------
# AiSensy
# -----------------------------------------------------------------------------
WHATOMATE_AISENSY_BASE_URL=https://backend.aisensy.com/direct-apis/t1
WHATOMATE_AISENSY_WEBHOOK_SECRET=

# -----------------------------------------------------------------------------
# Default admin (only seeded on first migrate when no users exist)
# -----------------------------------------------------------------------------
WHATOMATE_DEFAULT_ADMIN_EMAIL=admin@admin.com
WHATOMATE_DEFAULT_ADMIN_PASSWORD=CHANGE_ME_ON_FIRST_LOGIN
WHATOMATE_DEFAULT_ADMIN_FULL_NAME=Admin
